# CKey — base URL chính thức. Có thể đổi sang https://ckey.vn/v1 nếu api.xah.io bị chặn.
CKEY_BASE_URL=https://api.xah.io/v1
CKEY_API_KEY=sk-xxxxxxxx

# Listing gọi cứng ở M1. Chọn listing ĐÃ KIỂM CHỨNG, đừng chọn rẻ nhất chưa rõ.
# M1 chưa có fallback nên listing hỏng là request hỏng.
GATEWAY_DEFAULT_MODEL=dungcsnd113/claude-opus-5

# Timeout. Đã đo 40s cho 104 token output nên đừng để thấp.
GATEWAY_TTFB_TIMEOUT_MS=60000
GATEWAY_TOTAL_TIMEOUT_MS=300000

DATABASE_PATH=./data/gateway.db
