# CKey — base URL chính thức. Có thể đổi sang https://ckey.vn/v1 nếu api.xah.io bị chặn.
CKEY_BASE_URL=https://api.xah.io/v1
CKEY_API_KEY=sk-xxxxxxxx

# Listing gọi cứng ở M1. Chọn listing ĐÃ KIỂM CHỨNG, đừng chọn rẻ nhất chưa rõ.
# M1 chưa có fallback nên listing hỏng là request hỏng.
GATEWAY_DEFAULT_MODEL=dungcsnd113/claude-opus-5

# Timeout. Đã đo 40s cho 104 token output nên đừng để thấp.
GATEWAY_TTFB_TIMEOUT_MS=60000
GATEWAY_TOTAL_TIMEOUT_MS=300000

DATABASE_PATH=./data/gateway.db

# Vilao. Hai loại token KHÁC NHAU, không thay nhau được:
#   VILAO_API_KEY (sk-...)  → gọi model, header x-api-key
#   VILAO_PAT     (pat-...) → quản lý catalog/subscribe, header Bearer
# PAT lấy ở https://vilao.ai/console/user/api-tokens — FULL QUYỀN, gồm cả ví tiền.
# Bỏ trống cả hai thì gateway chỉ chạy CKey.
VILAO_BASE_URL=https://api.vilao.ai/v1
VILAO_MANAGE_URL=https://vilao.ai/api/v2
VILAO_API_KEY=
VILAO_PAT=
VILAO_KEY_ID=

# CORS cho app chạy trong trình duyệt gọi thẳng vào gateway. Mặc định mở mọi origin —
# chấp nhận được khi gateway chỉ ở localhost. Nếu đưa ra mạng thì thu hẹp lại:
# GATEWAY_CORS_ORIGINS=https://app-cua-ban.example,http://localhost:5173
GATEWAY_CORS_ORIGINS=*
